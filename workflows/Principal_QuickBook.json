              "type": "string"
            },
            {
              "id": "b35760e9-ca96-439b-abf5-dae9f5019ef1",
              "name": "cuerpo",
              "value": "={{\n(() => {\n  const d = $('Preparar Solicitud').item.json;\n\n  const faltantes = [];\n\n  if (!d.nombre) faltantes.push('nombre');\n  if (!d.correo) faltantes.push('correo');\n  if (!d.servicio) faltantes.push('servicio');\n  if (!d.fecha_preferida) faltantes.push('fecha preferida');\n  if (!d.hora_preferida) faltantes.push('hora preferida');\n  if (!d.whatsapp) faltantes.push('WhatsApp');\n\n  if (faltantes.length > 0) {\n    return 'Tu solicitud de reserva fue rechazada porque faltan los siguientes datos obligatorios: ' +\n      faltantes.join(', ') + '.';\n  }\n\n  return 'Hola ' + d.nombre +\n    ', tu solicitud de reserva para el ' +\n    d.fecha_preferida +\n    ' fue rechazada porque la fecha debe estar entre 1 y 7 días de anticipación.';\n})()\n}}",
              "type": "string"
            },
            {
              "id": "2f881dd6-5909-452d-99c8-3db6f093a4b1",
              "name": "Estado",
              "value": "Rechazado",
              "type": "string"
            }
          ]
        },
